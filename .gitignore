# ==========================================
# IntelliQuest - Root .gitignore
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace

# Node & Frontend Build
**/node_modules/
**/dist/
**/dist-ssr/
**/.turbo/
**/.next/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Java & Backend Build
**/target/
!.mvn/wrapper/maven-wrapper.jar
**/*.class
**/*.jar
**/*.war
**/*.ear

# Eclipse / STS IDE metadata
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans/
.sts4-cache/

# Environment and Secrets (deploy platforms inject via dashboard)
.env
.env.*
!.env.example
*-local.properties
application-local.properties

# Logs
logs/
*.log
